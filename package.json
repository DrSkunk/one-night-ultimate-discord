{
  "name": "one-night-ultimate-discord",
  "version": "1.0.1",
  "description": "Play One Night Ultimate Werewolf together with friends on Discord",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "register": "bun scripts/register-commands.ts",
    "build:executable": "bun build --compile --external=ffmpeg-static --no-compile-autoload-dotenv --no-compile-autoload-bunfig src/index.ts --outfile dist/werecord",
    "test": "bun test",
    "test:discord": "bun scripts/test-discord.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky || true"
  },
  "author": "Sebastiaan Jansen",
  "license": "ISC",
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DrSkunk/one-night-ultimate-discord.git"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.28.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/bun": "^1.4.5",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "husky": "^9",
    "lint-staged": "^17.6.1",
    "prettier": "^3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "packageManager": "bun@1.4.5"
}
