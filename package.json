{
  "name": "one-night-ultimate-discord",
  "version": "1.0.0",
  "description": "Play One Night Ultimate Werewolf together with friends on Discord",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "register": "bun scripts/register-commands.ts",
    "test": "bun test",
    "test:discord": "bun scripts/test-discord.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && prettier --check \"**/*.{js,ts,tsx}\"",
    "lint:fix": "oxlint --fix && prettier --write \"**/*.{js,ts,tsx}\"",
    "format": "prettier --write .",
    "prepare": "husky || true"
  },
  "author": "Sebastiaan Jansen",
  "license": "ISC",
  "lint-staged": {
    "*.ts": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DrSkunk/one-night-ultimate-discord.git"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.28.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "husky": "^9",
    "lint-staged": "^17.6.1",
    "oxlint": "^1.94.0",
    "prettier": "^3",
    "typescript": "~7.0.2"
  },
  "packageManager": "bun@1.4.5"
}
